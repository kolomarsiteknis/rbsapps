{
  "entities": {
    "DailyReport": {
      "title": "DailyReport",
      "type": "object",
      "description": "Laporan harian mandor / pengawas lapangan",
      "properties": {
        "id": { "type": "string" },
        "reportNumber": { "type": "string" },
        "date": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "blockCode": { "type": "string" },
        "supervisorName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reportNumber", "date", "clientId", "status"]
    },
    "ManagedUser": {
      "title": "ManagedUser",
      "type": "object",
      "description": "Akun pengguna sistem",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "fullName": { "type": "string" },
        "userLevel": { "type": "string" },
        "assignedClientId": { "type": "string" },
        "assignedBlockCodes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" }
      },
      "required": ["id", "username", "password", "userLevel", "status"]
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "type": "object",
      "description": "Profil identitas resmi perusahaan dan branding aplikasi",
      "properties": {
        "id": { "type": "string" },
        "officialName": { "type": "string" },
        "shortName": { "type": "string" },
        "tagline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "npwp": { "type": "string" },
        "nib": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "headOfficeAddress": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "officialName", "shortName", "updatedAt"]
    },
    "CompanyStaff": {
      "title": "CompanyStaff",
      "type": "object",
      "description": "Informasi data staff perusahaan dengan tanda tangan digital",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "jobRole": { "type": "string" },
        "staffLevel": { "type": "string" },
        "employeeIdNumber": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "signatureUrl": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "fullName", "jobRole", "staffLevel", "status"]
    },
    "Equipment": {
      "title": "Equipment",
      "type": "object",
      "description": "Master unit alat berat dan status operasional",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "model": { "type": "string" },
        "serialNumber": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "type", "status"]
    },
    "Worker": {
      "title": "Worker",
      "type": "object",
      "description": "Personil tim lapangan",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Master data SPK dan profil klien",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contractNumber": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "contractNumber"]
    },
    "Block": {
      "title": "Block",
      "type": "object",
      "description": "Blok pengerjaan proyek",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "code": { "type": "string" },
        "targetAreaHa": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "clientId", "code"]
    },
    "ConnectionHealth": {
      "title": "ConnectionHealth",
      "type": "object",
      "description": "Dokumen ping untuk validasi koneksi real-time server",
      "properties": {
        "ping": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/dailyReports/{reportId}": {
      "schema": "DailyReport",
      "description": "Koleksi laporan harian proyek"
    },
    "/managedUsers/{userId}": {
      "schema": "ManagedUser",
      "description": "Koleksi kredensial dan penugasan user"
    },
    "/companyProfile/{docId}": {
      "schema": "CompanyProfile",
      "description": "Profil dan identitas resmi perusahaan"
    },
    "/companyStaff/{staffId}": {
      "schema": "CompanyStaff",
      "description": "Data staff perusahaan dan tanda tangan digital"
    },
    "/equipments/{equipmentId}": {
      "schema": "Equipment",
      "description": "Master data alat berat"
    },
    "/workers/{workerId}": {
      "schema": "Worker",
      "description": "Master data personil dan tenaga kerja"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Master data klien dan kontrak SPK"
    },
    "/blocks/{blockId}": {
      "schema": "Block",
      "description": "Master data blok kerja"
    },
    "/_connection_health/{pingId}": {
      "schema": "ConnectionHealth",
      "description": "Health check ping document"
    }
  }
}
